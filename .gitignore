# Per-user Xcode state (never commit)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# XcodeGen-generated project (regenerated via `xcodegen generate`)
*.xcodeproj/

# ---- Swift Package Manager ----
.build/
.swiftpm/
Package.resolved
# Note: app-level Package.resolved may be committed later if a dependency graph is pinned.

# ---- CocoaPods / Carthage (not used yet, ignored defensively) ----
Pods/
Carthage/Build/

